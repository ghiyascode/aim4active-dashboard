# Databases are never committed. They contain participant and message data.
*.db
*.db-shm
*.db-wal

# The generated snapshot is derived from the database, so it is not committed
# either. Rebuild it with `npm run snapshot`.
public/admin/data/snapshot.json
# and the copy mounted into the container
/snapshot.json

node_modules/
build/

# Who can sign in. Holds no passwords, but it is the access list, so it stays
# local. Rebuild the snapshot after changing it (npm run users).
/users.json

# Kept local: deployment notes and server specifics are not for the public repo.
DEPLOYMENT.md

npm-debug.log*
yarn-error.log*
.env
.env.local
.DS_Store
.vscode/
